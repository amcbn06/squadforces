ADMIN_PASSWORD=changeme
SECRET_KEY=change-this-secret-key-in-production
# Local: sqlite:///./squadforces.db
# Railway (cu volum montat pe /data): sqlite:////data/squadforces.db
DATABASE_URL=sqlite:///./squadforces.db
CF_API_KEY=
CF_API_SECRET=
SYNC_INTERVAL_HOURS=2
# Registration is by invite link (made by the admin or a group owner). Set to 1 only for local development.
ALLOW_OPEN_REGISTRATION=
# Base URL used in invite links; defaults to Railway's public domain, then to the address of the request.
PUBLIC_URL=
